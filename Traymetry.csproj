<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>Traymetry</AssemblyName>
    <RootNamespace>Traymetry</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tmp\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="lib\*.dll">
      <LogicalName>Traymetry.Embedded.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="vendor\PawnIO\COPYING.txt">
      <LogicalName>Traymetry.Licenses.PawnIO-COPYING.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="vendor\PawnIO\LICENSE-NOTICE.md">
      <LogicalName>Traymetry.Licenses.PawnIO-NOTICE.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="vendor\PresentMon\PresentMon-2.5.1-x64.exe">
      <LogicalName>Traymetry.Embedded.PresentMon-2.5.1-x64.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="vendor\PresentMon\LICENSE.txt">
      <LogicalName>Traymetry.Licenses.PresentMon-MIT.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md">
      <LogicalName>Traymetry.Licenses.THIRD-PARTY-NOTICES.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
